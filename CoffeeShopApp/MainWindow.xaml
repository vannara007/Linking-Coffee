<Window x:Class="CoffeeShopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="☕ Coffee Shop" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5E6">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Grid.Row="0" Text="☕ Welcome to Our Coffee Shop" 
                   FontSize="32" FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"
                   Foreground="#4A2C2A"/>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Menu Section -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="☕ Coffee Drinks" FontSize="20" FontWeight="Bold" 
                               Foreground="#4A2C2A" Margin="0,0,0,15"/>
                    
                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="btnEspresso" Content="Espresso&#10;$3.50" 
                                Width="120" Height="80" Margin="5" 
                                Background="#D4A574" BorderThickness="0"
                                Click="btnEspresso_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <Button x:Name="btnCappuccino" Content="Cappuccino&#10;$4.50" 
                                Width="120" Height="80" Margin="5" 
                                Background="#D4A574" BorderThickness="0"
                                Click="btnCappuccino_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <Button x:Name="btnLatte" Content="Latte&#10;$4.75" 
                                Width="120" Height="80" Margin="5" 
                                Background="#D4A574" BorderThickness="0"
                                Click="btnLatte_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <Button x:Name="btnMocha" Content="Mocha&#10;$5.00" 
                                Width="120" Height="80" Margin="5" 
                                Background="#D4A574" BorderThickness="0"
                                Click="btnMocha_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <Button x:Name="btnAmericano" Content="Americano&#10;$3.75" 
                                Width="120" Height="80" Margin="5" 
                                Background="#D4A574" BorderThickness="0"
                                Click="btnAmericano_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </WrapPanel>
                    
                    <TextBlock Text="🥐 Pastries" FontSize="20" FontWeight="Bold" 
                               Foreground="#4A2C2A" Margin="0,20,0,15"/>
                    
                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="btnCroissant" Content="Croissant&#10;$3.25" 
                                Width="120" Height="80" Margin="5" 
                                Background="#C9B037" BorderThickness="0"
                                Click="btnCroissant_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <Button x:Name="btnMuffin" Content="Muffin&#10;$3.00" 
                                Width="120" Height="80" Margin="5" 
                                Background="#C9B037" BorderThickness="0"
                                Click="btnMuffin_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <Button x:Name="btnCookie" Content="Cookie&#10;$2.50" 
                                Width="120" Height="80" Margin="5" 
                                Background="#C9B037" BorderThickness="0"
                                Click="btnCookie_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="8" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
            
            <!-- Cart Section -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="15" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="🛒 Your Order" FontSize="20" FontWeight="Bold" 
                               Foreground="#4A2C2A" Margin="0,0,0,15"/>
                    
                    <DataGrid ItemsSource="{Binding Cart}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" Height="300" 
                              Background="Transparent" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:C}}" Width="80"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, StringFormat={}{0:C}}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <TextBlock x:Name="lblTotal" Text="Total: $0.00" 
                               FontSize="24" FontWeight="Bold" 
                               HorizontalAlignment="Right" 
                               Margin="0,20,0,20"
                               Foreground="#4A2C2A"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnClear" Content="Clear Cart" 
                                Width="120" Height="40" Margin="5"
                                Background="#E74C3C" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Click="btnClear_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="5" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <Button x:Name="btnCheckout" Content="Checkout" 
                                Width="120" Height="40" Margin="5"
                                Background="#27AE60" Foreground="White"
                                BorderThickness="0" Cursor="Hand"
                                Click="btnCheckout_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            CornerRadius="5" Padding="10">
                                        <ContentPresenter HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
