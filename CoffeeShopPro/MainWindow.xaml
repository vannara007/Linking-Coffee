<Window x:Class="CoffeeShopPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Coffee Shop Pro - POS System" 
        Height="700" Width="1200"
        WindowState="Maximized"
        Background="#F5F5DC">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Top Bar -->
        <Border Grid.Row="0" Background="#6F4E37" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock Grid.Column="0" Text="☕ Coffee Shop Pro" 
                          FontSize="28" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Server: " Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtCurrentStaff" Text="Not Logged In" 
                              Foreground="#FFD700" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Grid.Column="2" Content="⚙ Settings" Click="btnSettings_Click" 
                       Background="#8B6914" FontSize="16" Padding="15,8"/>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Products Section -->
            <Border Grid.Column="0" BorderBrush="#6F4E37" BorderThickness="1" CornerRadius="5" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Category Filter -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                        <TextBlock Text="Category:" VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cmbCategory" Width="150" SelectionChanged="cmbCategory_SelectionChanged"/>
                        <Button Content="All" Click="btnAllCategories_Click" Margin="10,0,0,0"/>
                    </StackPanel>
                    
                    <!-- Products Grid -->
                    <ItemsControl x:Name="lstProducts" Grid.Row="1" Margin="10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="#6F4E37" BorderThickness="1" 
                                       CornerRadius="8" Margin="5" Padding="15" Width="180" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#FFF8DC"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock Grid.Row="0" Text="{Binding Name}" 
                                                  FontSize="18" FontWeight="Bold" 
                                                  HorizontalAlignment="Center" Margin="0,0,0,10"
                                                  TextWrapping="Wrap"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Category}" 
                                                  FontSize="12" Foreground="Gray" 
                                                  HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                        <TextBlock Grid.Row="2" Text="{Binding Price, StringFormat=${0:F2}}" 
                                                  FontSize="20" Foreground="#6F4E37" FontWeight="Bold"
                                                  HorizontalAlignment="Center"/>
                                    </Grid>
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" 
                                                     CommandParameter="{Binding}"
                                                     Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                    </Border.InputBindings>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            
            <!-- Cart Section -->
            <Border Grid.Column="1" BorderBrush="#6F4E37" BorderThickness="1" CornerRadius="5" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="🛒 Current Order" 
                              FontSize="20" FontWeight="Bold" 
                              Margin="10" HorizontalAlignment="Center"/>
                    
                    <!-- Cart Items -->
                    <DataGrid x:Name="dgCart" Grid.Row="1" AutoGenerateColumns="False" 
                             CanUserAddRows="False" CanUserDeleteRows="False"
                             HeadersVisibility="Column" Margin="10"
                             Background="White">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="40"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=${0:F2}}" Width="60"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat=${0:F2}}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <!-- Discount Section -->
                    <Border Grid.Row="2" Background="#FFF8DC" Margin="10" Padding="10" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Discount (%):" 
                                      VerticalAlignment="Center" FontSize="14"/>
                            <TextBox x:Name="txtDiscount" Grid.Row="0" Grid.Column="1" 
                                    Width="80" Text="0" TextChanged="txtDiscount_TextChanged"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Discount Amount:" 
                                      VerticalAlignment="Center" FontSize="14" Margin="0,5,0,0"/>
                            <TextBlock x:Name="txtDiscountAmount" Grid.Row="1" Grid.Column="1" 
                                      Text="$0.00" VerticalAlignment="Center" 
                                      FontSize="14" FontWeight="Bold" Margin="0,5,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- Totals and Actions -->
                    <Border Grid.Row="3" Background="#6F4E37" Padding="15" CornerRadius="0,0,5,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Subtotal:" 
                                      FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtSubtotal" Grid.Row="0" Grid.Column="1" 
                                      Text="$0.00" FontSize="16" Foreground="White"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Discount:" 
                                      FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtDiscountDisplay" Grid.Row="1" Grid.Column="1" 
                                      Text="-$0.00" FontSize="16" Foreground="#FFD700"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="TOTAL:" 
                                      FontSize="20" FontWeight="Bold" Foreground="#FFD700" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtTotal" Grid.Row="2" Grid.Column="1" 
                                      Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="#FFD700"/>
                            
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                                       Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                <Button Content="Clear Cart" Click="btnClearCart_Click" 
                                       Background="#A52A2A" Width="120" Margin="5"/>
                                <Button Content="Checkout" Click="btnCheckout_Click" 
                                       Background="#228B22" Width="120" Margin="5"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Login Button (Bottom) -->
        <Border Grid.Row="2" Background="#6F4E37" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnLogin" Content="👤 Login" Click="btnLogin_Click" 
                       Background="#8B6914" FontSize="16" Padding="20,10"/>
                <Button x:Name="btnLogout" Content="🚪 Logout" Click="btnLogout_Click" 
                       Background="#A52A2A" FontSize="16" Padding="20,10" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
