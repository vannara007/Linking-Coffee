<Window x:Class="CoffeeShopPro.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Checkout" Height="500" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5DC">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="💳 Checkout" 
                  FontSize="24" FontWeight="Bold" 
                  HorizontalAlignment="Center" Margin="0,0,0,15"
                  Foreground="#6F4E37"/>
        
        <!-- Order Summary -->
        <Border Grid.Row="1" Background="White" BorderBrush="#6F4E37" 
               BorderThickness="1" CornerRadius="5" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DataGrid x:Name="dgOrderItems" AutoGenerateColumns="False" 
                             CanUserAddRows="False" CanUserDeleteRows="False"
                             HeadersVisibility="Column" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="40"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, StringFormat=${0:F2}}" Width="60"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, StringFormat=${0:F2}}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <Separator Margin="0,10"/>
                    
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Subtotal:" FontSize="16"/>
                        <TextBlock x:Name="txtSubtotal" Grid.Column="1" Text="$0.00" FontSize="16"/>
                    </Grid>
                    
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Discount:" FontSize="16"/>
                        <TextBlock x:Name="txtDiscount" Grid.Column="1" Text="-$0.00" FontSize="16" Foreground="Green"/>
                    </Grid>
                    
                    <Separator Margin="0,10"/>
                    
                    <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TOTAL:" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="txtTotal" Grid.Column="1" Text="$0.00" FontSize="24" FontWeight="Bold" Foreground="#6F4E37"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
        
        <!-- Payment Method -->
        <Border Grid.Row="2" Background="#FFF8DC" Margin="0,15,0,0" Padding="15" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Payment Method:" 
                          FontSize="16" VerticalAlignment="Center" Margin="0,0,10,10"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton x:Name="rbCash" Content="Cash" GroupName="Payment" IsChecked="True" FontSize="16" Margin="0,0,15,0"/>
                    <RadioButton x:Name="rbCard" Content="Credit Card" GroupName="Payment" FontSize="16" Margin="0,0,15,0"/>
                    <RadioButton x:Name="rbMobile" Content="Mobile Pay" GroupName="Payment" FontSize="16"/>
                </StackPanel>
                
                <CheckBox x:Name="chkPrintReceipt" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                         Content="🖨 Print Receipt" FontSize="16" IsChecked="True" Margin="0,5,0,0"/>
            </Grid>
        </Border>
        
        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" 
                   HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Complete Sale" Click="btnComplete_Click" 
                   Width="140" Background="#228B22" FontSize="16"/>
            <Button Content="Cancel" Click="btnCancel_Click" 
                   Width="100" Background="Gray" FontSize="16" Margin="15,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
