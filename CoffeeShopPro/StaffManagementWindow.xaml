<Window x:Class="CoffeeShopPro.StaffManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staff Management" Height="350" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5DC">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" x:Name="txtTitle" Text="➕ Add Staff" 
                  FontSize="24" FontWeight="Bold" 
                  HorizontalAlignment="Center" Margin="0,0,0,20"
                  Foreground="#6F4E37"/>
        
        <StackPanel Grid.Row="1">
            <TextBlock Text="Name:" FontSize="14" Margin="0,0,0,5"/>
            <TextBox x:Name="txtName" FontSize="14"/>
            
            <TextBlock Text="Role:" FontSize="14" Margin="0,15,0,5"/>
            <ComboBox x:Name="cmbRole" FontSize="14">
                <ComboBoxItem Content="Manager"/>
                <ComboBoxItem Content="Barista"/>
                <ComboBoxItem Content="Cashier"/>
            </ComboBoxItem>
            
            <TextBlock Text="PIN Code (4 digits):" FontSize="14" Margin="0,15,0,5"/>
            <PasswordBox x:Name="txtPinCode" FontSize="18" Padding="10" 
                        MaxLength="4" PasswordChar="●"/>
            
            <TextBlock x:Name="txtError" Text="" 
                      Foreground="Red" FontSize="14" 
                      Margin="0,10,0,0" Visibility="Collapsed"/>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                   HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="💾 Save" Click="btnSave_Click" 
                   Width="100" Background="#6F4E37"/>
            <Button Content="Cancel" Click="btnCancel_Click" 
                   Width="100" Background="Gray" Margin="15,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
