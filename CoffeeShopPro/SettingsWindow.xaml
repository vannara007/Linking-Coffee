<Window x:Class="CoffeeShopPro.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="550" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5DC">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="⚙ Settings" 
                  FontSize="24" FontWeight="Bold" 
                  HorizontalAlignment="Center" Margin="0,0,0,20"
                  Foreground="#6F4E37"/>
        
        <TabControl Grid.Row="1">
            <!-- Shop Info Tab -->
            <TabItem Header="🏪 Shop Info">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Shop Name:" FontSize="14" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtShopName" FontSize="14"/>
                        
                        <TextBlock Text="Address:" FontSize="14" Margin="0,15,0,5"/>
                        <TextBox x:Name="txtShopAddress" FontSize="14"/>
                        
                        <TextBlock Text="Phone:" FontSize="14" Margin="0,15,0,5"/>
                        <TextBox x:Name="txtShopPhone" FontSize="14"/>
                        
                        <TextBlock Text="Tax Rate (%):" FontSize="14" Margin="0,15,0,5"/>
                        <TextBox x:Name="txtTaxRate" FontSize="14"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Printer Tab -->
            <TabItem Header="🖨 Printer">
                <StackPanel Margin="10">
                    <TextBlock Text="Select Receipt Printer:" FontSize="14" Margin="0,0,0,10"/>
                    <ComboBox x:Name="cmbPrinters" FontSize="14"/>
                    
                    <TextBlock Text="Selected Printer:" FontSize="14" Margin="0,20,0,5"/>
                    <TextBlock x:Name="txtSelectedPrinter" FontSize="14" FontWeight="Bold" 
                              Foreground="#6F4E37"/>
                    
                    <Button Content="Test Print" Click="btnTestPrint_Click" 
                           Margin="0,20,0,0" Background="#6F4E37"/>
                    
                    <TextBlock TextWrapping="Wrap" FontSize="12" FontStyle="Italic"
                              Foreground="Gray" Margin="0,15,0,0">
                        Note: Make sure your receipt printer is connected and installed before selecting.
                    </TextBlock>
                </StackPanel>
            </TabItem>
            
            <!-- Staff Management Tab -->
            <TabItem Header="👥 Staff">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="➕ Add Staff" Click="btnAddStaff_Click" Background="#6F4E37"/>
                        <Button Content="✏️ Edit" Click="btnEditStaff_Click" Margin="10,0,0,0"/>
                        <Button Content="🗑 Deactivate" Click="btnDeactivateStaff_Click" Margin="10,0,0,0" Background="#A52A2A"/>
                    </StackPanel>
                    
                    <DataGrid x:Name="dgStaff" Grid.Row="1" AutoGenerateColumns="False" 
                             CanUserAddRows="False" CanUserDeleteRows="False"
                             HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                   HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="💾 Save" Click="btnSave_Click" 
                   Width="100" Background="#228B22" FontSize="16"/>
            <Button Content="Cancel" Click="btnCancel_Click" 
                   Width="100" Background="Gray" FontSize="16" Margin="15,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
