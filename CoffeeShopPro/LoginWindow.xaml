<Window x:Class="CoffeeShopPro.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Staff Login" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5DC">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="👤 Staff Login" 
                  FontSize="24" FontWeight="Bold" 
                  HorizontalAlignment="Center" Margin="0,0,0,20"
                  Foreground="#6F4E37"/>
        
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Enter PIN Code:" FontSize="16" Margin="0,0,0,10"/>
            <PasswordBox x:Name="txtPinCode" FontSize="18" Padding="10" 
                        MaxLength="4" PasswordChar="●"/>
            
            <TextBlock x:Name="txtError" Text="" 
                      Foreground="Red" FontSize="14" 
                      Margin="0,10,0,0" Visibility="Collapsed"/>
        </StackPanel>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                   HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="Login" Click="btnLogin_Click" 
                   Width="100" Background="#6F4E37"/>
            <Button Content="Cancel" Click="btnCancel_Click" 
                   Width="100" Background="Gray" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
